PROCESSOR_API_KEY=replace-with-a-long-random-secret
PROCESSOR_HOST=127.0.0.1
PROCESSOR_PORT=8080
MTS_SESSION_ID=
WHISPER_MODEL=large-v3
WHISPER_WORKERS=auto
WHISPER_CPU_THREADS=auto
WHISPER_AUTOTUNE=1
WHISPER_AUTOTUNE_TIMEOUT_SECONDS=180
TRANSCRIPTION_TIMEOUT_SECONDS=10800
# Десятичные гигабайты: 0.25 = 250 МБ, 1 = 1000 МБ.
MAX_UPLOAD_GB=10
SERVER_MAX_CONCURRENT_JOBS=1
SERVER_MAX_PENDING_JOBS=32
JOB_RETENTION_SECONDS=86400
